# Copy the keys you need into .env (or .env.local). Never commit the real file.
MONGODB_URI=mongodb://127.0.0.1:27017/todo-app

# GitHub OAuth App — see docs/GITHUB_OAUTH.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional. Defaults to <request origin>/auth/github/callback.
# Must exactly match the "Authorization callback URL" of the OAuth App.
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
